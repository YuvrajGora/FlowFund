# FlowFund Environment Variables Configuration Template
# Copy this file to .env for local development

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Security
# Generate a strong 64-character random string for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
SECRET_KEY=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Database Configuration
# Local development uses SQLite automatically if DATABASE_URL is not set.
# In production on Render, set DATABASE_URL to your PostgreSQL instance:
# DATABASE_URL=postgresql://user:password@host:5432/flowfund?sslmode=require
# DATABASE_URL=

